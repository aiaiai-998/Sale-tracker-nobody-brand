# Nobody's Brand Live Sales — environment variables
# Copy this file to .env and fill in your private values

# Roblox Group ID for Nobody's Brand
ROBLOX_GROUP_ID=201198194

# Comma-separated Limited UGC asset IDs to track
UGC_ASSET_IDS=137910150798027,129297459934395,121581072690400

# Poll every 7s for group sales (5–10s recommended). Roblox has no true webhooks, so this is near-live.
POLL_INTERVAL_MS=7000

# Poll every 30s for Limited stock counts (15–30s recommended)
INVENTORY_POLL_INTERVAL_MS=30000

# Private .ROBLOSECURITY cookie — ONLY set on the server (Render env var, never in frontend)
# Leave empty to run in demo mode (overlay still works, shows simulated sales)
ROBLOX_COOKIE=

# Server port (Render sets PORT automatically)
PORT=3000
